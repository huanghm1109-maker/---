# 复制为 .streamlit/secrets.toml 后填写真实值。
# 不要把填写后的 secrets.toml 提交到 Git。

[authenticator]
cookie_name = "wordbook_auth"
cookie_key = "请替换为至少32位随机字符串"
cookie_expiry_days = 30
# 建议设置，仅在知道邀请码时才允许注册。
registration_code = "换成一个只有同学知道的邀请码"

[database]
# Supabase Project Settings > Database > Connection string > URI
url = "postgresql://postgres.project-ref:password@host:5432/postgres?sslmode=require"
